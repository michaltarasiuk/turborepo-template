{
  "name": "turborepo-template",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "check": "turbo run lint format typecheck && turbo boundaries",
    "check:fix": "turbo run lint:fix format:fix",
    "typecheck": "turbo run typecheck",
    "boundaries": "turbo boundaries",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "devDependencies": {
    "eslint-plugin-turbo": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
